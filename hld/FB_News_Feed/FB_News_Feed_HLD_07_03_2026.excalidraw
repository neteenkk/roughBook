        }
      ],
      "updated": 1783081657734,
      "link": null,
      "locked": false,
      "text": "  const cursor = req.query.cursor as string | undefined;\n  const cursorTimestamp = cursor ? decodeCursor(cursor) : Date.now();\n\n  // Fetch one extra row so we know whether there's a next page\n  const posts = await getFeedPosts(userId, cursorTimestamp, clampedSize + 1);\n\n  const hasMore = posts.length > clampedSize;\n  const items = hasMore ? posts.slice(0, clampedSize) : posts;\n\n  const nextCursor = hasMore\n    ? encodeCursor(items[items.length - 1])\n    : null;\n\n  const response: FeedResponse = { items, nextCursor };\n  res.json(response);",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "  const cursor = req.query.cursor as string | undefined;\n  const cursorTimestamp = cursor ? decodeCursor(cursor) : Date.now();\n\n  // Fetch one extra row so we know whether there's a next page\n  const posts = await getFeedPosts(userId, cursorTimestamp, clampedSize + 1);\n\n  const hasMore = posts.length > clampedSize;\n  const items = hasMore ? posts.slice(0, clampedSize) : posts;\n\n  const nextCursor = hasMore\n    ? encodeCursor(items[items.length - 1])\n    : null;\n\n  const response: FeedResponse = { items, nextCursor };\n  res.json(response);",
      "autoResize": true,
      "lineHeight": 1.25
    },
