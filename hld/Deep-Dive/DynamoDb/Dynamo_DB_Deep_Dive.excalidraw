    {
      "id": "fKJzWCDJ5l9Kulf4UV9yx",
      "type": "text",
      "x": -3871.977960628731,
      "y": 8182.992186391688,
      "width": 1410.5516357421875,
      "height": 675,
      "angle": 0,
      "strokeColor": "#1e1e1e",
