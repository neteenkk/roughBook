      "groupIds": [],
      "frameId": null,
      "index": "b9E",
      "roundness": null,
      "seed": 646710978,
      "version": 74,
      "versionNonce": 1355777282,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783158903480,
      "link": null,
      "locked": false,
      "text": " DynamoDB uses the partition key's value to determine the physical location of the item within the database. \n This value is hashed to determine the partition where the item is stored",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": " DynamoDB uses the partition key's value to determine the physical location of the item within the database. \n This value is hashed to determine the partition where the item is stored",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ErEfDPo8pXG5p2cKIPVLM",
      "type": "text",
      "x": 225.14306599263,
