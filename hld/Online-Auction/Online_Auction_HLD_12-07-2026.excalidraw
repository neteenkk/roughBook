    {
      "id": "UBqqvZE3a4vTQ1eK48Ror",
      "type": "text",
      "x": 12726.81396001002,
      "y": 9075.735490182553,
      "width": 812.7557373046875,
      "height": 595,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b380G",
      "roundness": null,
      "seed": 1363908760,
      "version": 56,
      "versionNonce": 1282084504,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1783865812609,
      "link": null,
      "locked": false,
      "text": "BEGIN;\n\n-- Lock all existing bid rows for this auction\nSELECT id, amount FROM bids\nWHERE auction_id = :auction_id\nFOR UPDATE;\n\n-- Get current max (from the locked rows)\nSELECT MAX(amount) AS max_bid FROM bids\nWHERE auction_id = :auction_id;\n\n-- Insert if the new bid beats the current max\nINSERT INTO bids (auction_id, user_id, amount, bid_time)\nVALUES (:auction_id, :user_id, :amount, NOW())\nWHERE :amount > COALESCE(:max_bid, 0);\n\nCOMMIT;",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "ZEhMgTT8J6Q4QK97zqUc_",
      "originalText": "BEGIN;\n\n-- Lock all existing bid rows for this auction\nSELECT id, amount FROM bids\nWHERE auction_id = :auction_id\nFOR UPDATE;\n\n-- Get current max (from the locked rows)\nSELECT MAX(amount) AS max_bid FROM bids\nWHERE auction_id = :auction_id;\n\n-- Insert if the new bid beats the current max\nINSERT INTO bids (auction_id, user_id, amount, bid_time)\nVALUES (:auction_id, :user_id, :amount, NOW())\nWHERE :amount > COALESCE(:max_bid, 0);\n\nCOMMIT;",
      "autoResize": true,
      "lineHeight": 1.25
    },
