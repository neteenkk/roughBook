    {
      "id": "T4QUaSYNi79cbIY8hIb35",
      "type": "text",
      "x": 10678.114616428044,
      "y": 11610.709742711468,
      "width": 931.2661453179823,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
