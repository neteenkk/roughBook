      "seed": 1865869954,
      "version": 79,
      "versionNonce": 995792727,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783252488777,
      "link": null,
      "locked": false,
      "text": "{\n  id: string,\n  title: string,\n  question: string,\n  level: string,\n  tags: string[],\n  codeStubs: {\n    python: string,\n    javascript: string,\n    typescript: string,\n    ...\n  },\n  testCases: {\n    type: string,\n    input: JSON,\n    output: JSON\n  }[]\n}",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "{\n  id: string,\n  title: string,\n  question: string,\n  level: string,\n  tags: string[],\n  codeStubs: {\n    python: string,\n    javascript: string,\n    typescript: string,\n    ...\n  },\n  testCases: {\n    type: string,\n    input: JSON,\n    output: JSON\n  }[]\n}",
