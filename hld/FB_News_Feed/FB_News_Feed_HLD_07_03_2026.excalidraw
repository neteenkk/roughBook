      "index": "b55",
      "roundness": null,
      "seed": 137063006,
      "version": 95,
      "versionNonce": 1216513438,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "Euk1zf76ptrtIWnYf9n95",
