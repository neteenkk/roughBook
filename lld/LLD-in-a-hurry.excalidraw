      "updated": 1786761377993,
      "link": null,
      "locked": false,
      "text": "1) Requirements (5 min)\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) Requirements (5 min)\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "YW52yq5GIfzPDf_OFQYHr",
      "type": "text",
      "x": 9918.222501643828,
      "y": 8766.58678855602,
      "width": 1114.319091796875,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5d",
      "roundness": null,
      "seed": 121943265,
      "version": 63,
      "versionNonce": 1224982479,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786761410022,
      "link": null,
      "locked": false,
      "text": "- Primary capabilities — What operations must this system support?\n- Rules and completion — What conditions define success, failure, or when the system stops or transitions state?\n- Error handling — How should the system respond when inputs or actions are invalid?\n- Scope boundaries — What areas are in scope (core logic, business rules) and \n                          what areas are explicitly out (UI, storage, networking, concurrency, extensibility)?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Primary capabilities — What operations must this system support?\n- Rules and completion — What conditions define success, failure, or when the system stops or transitions state?\n- Error handling — How should the system respond when inputs or actions are invalid?\n- Scope boundaries — What areas are in scope (core logic, business rules) and \n                          what areas are explicitly out (UI, storage, networking, concurrency, extensibility)?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "sgke65NZArc9dV5dAqHaZ",
      "type": "text",
      "x": 9889.653154589676,
      "y": 8933.604461183342,
      "width": 336.4197692871094,
      "height": 25,
