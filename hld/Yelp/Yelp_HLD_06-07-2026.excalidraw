      "isDeleted": false,
      "boundElements": null,
      "updated": 1783311800745,
      "link": null,
      "locked": false,
      "text": "\n- Great Sol: ElasticSearch\n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n- Great Sol: ElasticSearch\n",
