    {
      "id": "_id0D8T7ZRFD-oEDsIi1s",
      "type": "text",
      "x": 10722.679921969388,
      "y": 12133.395379916137,
      "width": 1424.9310539181583,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0u",
      "roundness": null,
      "seed": 2111110365,
      "version": 75,
      "versionNonce": 1382231197,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783311807462,
      "link": null,
      "locked": false,
      "text": "Location: To efficiently search by location we need to use a geospatial index like geohashes, quadtrees,\nor R-trees.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Location: To efficiently search by location we need to use a geospatial index like geohashes, quadtrees, or R-trees.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "5J-g9J3u8jirg3I0BHuHV",
      "type": "text",
      "x": 10726.109486735326,
      "y": 12223.53463627145,
      "width": 1429.7304584456228,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0v",
      "roundness": null,
      "seed": 866880371,
      "version": 109,
      "versionNonce": 1257576637,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783311818641,
      "link": null,
      "locked": false,
      "text": "Name: To efficiently search by name we need to use a full text search index which uses a technique\ncalled inverted indexes to quickly search for terms in a document.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Name: To efficiently search by name we need to use a full text search index which uses a technique called inverted indexes to quickly search for terms in a document.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "3i8faSj-M6XOizcVV40Zu",
      "type": "text",
      "x": 10722.217569066604,
      "y": 12321.7104643779,
      "width": 1349.2299799926986,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0w",
      "roundness": null,
      "seed": 1463507261,
      "version": 106,
