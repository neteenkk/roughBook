      "index": "b9G",
      "roundness": null,
      "seed": 2078968450,
      "version": 45,
      "versionNonce": 1666165890,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783158903480,
      "link": null,
      "locked": false,
      "text": "An additional attribute that, when combined with the partition key, forms a composite primary key\nThe sort key is used to order items with the same partition key value, enabling efficient range queries and sorting within a partition",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "An additional attribute that, when combined with the partition key, forms a composite primary key\nThe sort key is used to order items with the same partition key value, enabling efficient range queries and sorting within a partition",
      "autoResize": true,
      "lineHeight": 1.25
    },
