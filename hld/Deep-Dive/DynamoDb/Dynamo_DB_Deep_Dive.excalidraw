      "index": "b55",
      "roundness": null,
      "seed": 137063006,
      "version": 96,
      "versionNonce": 665900354,
      "isDeleted": true,
      "boundElements": [
        {
          "id": "Euk1zf76ptrtIWnYf9n95",
