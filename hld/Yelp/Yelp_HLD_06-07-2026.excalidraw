      "index": "ar",
      "roundness": null,
      "seed": 205464659,
      "version": 108,
      "versionNonce": 861775475,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783268318300,
      "link": null,
      "locked": false,
      "text": "Functional Requirements\n1. User should be able to search for buisness by name, location\n and category",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements\n1. User should be able to search for buisness by name, location\n and category",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "yDdvaGgjXEqy9rCRGBoZd",
      "type": "text",
      "x": 7055.044079238492,
      "y": 9350.762967761993,
      "width": 1065.0357666015625,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "as",
      "roundness": null,
      "seed": 1446759773,
      "version": 193,
      "versionNonce": 1563294397,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783268477792,
      "link": null,
      "locked": false,
      "text": "2. User should be able to view buisness and review\n3. User should be able to leave reviews on buisness (mandatory 1-5 rating and\n   optional text)",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. User should be able to view buisness and review\n3. User should be able to leave reviews on buisness (mandatory 1-5 rating and\n   optional text)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "KSd_KsAPuXdaYSpHAr0tu",
      "type": "text",
      "x": 7054.81186137255,
      "y": 9513.830884306017,
      "width": 1011.5556640625,
      "height": 245,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "at",
      "roundness": null,
      "seed": 2147455155,
      "version": 318,
      "versionNonce": 1555607475,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783268620177,
      "link": null,
      "locked": false,
      "text": "Out of Scope\n- User should be able to view buisness on a map\n\nNon Functional Requirements\n1. System should have low latency for search (<500ms)\n2. System should be highly availaible, eventual consistency is fine\n3. System should be scalable to handle 100M daily users and 10M buisness",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Out of Scope\n- User should be able to view buisness on a map\n\nNon Functional Requirements\n1. System should have low latency for search (<500ms)\n2. System should be highly availaible, eventual consistency is fine\n3. System should be scalable to handle 100M daily users and 10M buisness",
      "autoResize": true,
      "lineHeight": 1.25
    },
