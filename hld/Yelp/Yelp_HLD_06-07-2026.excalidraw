      "text": "- we would add a DB Constraint\n\nALTER TABLE reviews\nADD CONSTRAINT unique_user_business UNIQUE (user_id, business_id);",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- we would add a DB Constraint\n\nALTER TABLE reviews\nADD CONSTRAINT unique_user_business UNIQUE (user_id, business_id);",
      "autoResize": true,
