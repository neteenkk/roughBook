      "width": 223.41189575195312,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b95",
      "roundness": null,
      "seed": 815601154,
      "version": 82,
      "versionNonce": 1766819166,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783157796231,
      "link": null,
      "locked": false,
      "text": "The Data Model\n",
      "fontSize": 28,
      "fontFamily": 5,
