    {
      "id": "fxVbMnix1nYTAr3kiMizQ",
      "type": "text",
      "x": 12132.29290509676,
      "y": 13072.500071345496,
      "width": 1197.9064700998288,
      "height": 630,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4K",
      "roundness": null,
      "seed": 1739833240,
      "version": 156,
      "versionNonce": 314059496,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783867438607,
      "link": null,
      "locked": false,
      "text": "class AuctionEventManager {\n  private connections: Map<string, Set<Response>> = new Map();\n  \n  addConnection(auctionId: string, connection: Response) {\n    if (!this.connections.has(auctionId)) {\n      this.connections.set(auctionId, new Set());\n    }\n    this.connections.get(auctionId).add(connection);\n  }\n  \n  broadcastNewBid(auctionId: string, maxBid: number) {\n    const connections = this.connections.get(auctionId);\n    if (connections) {\n      const event = `data: ${JSON.stringify({ maxBid })}\\n\\n`;\n      connections.forEach(response => response.write(event));\n    }\n  }\n}",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class AuctionEventManager {\n  private connections: Map<string, Set<Response>> = new Map();\n  \n  addConnection(auctionId: string, connection: Response) {\n    if (!this.connections.has(auctionId)) {\n      this.connections.set(auctionId, new Set());\n    }\n    this.connections.get(auctionId).add(connection);\n  }\n  \n  broadcastNewBid(auctionId: string, maxBid: number) {\n    const connections = this.connections.get(auctionId);\n    if (connections) {\n      const event = `data: ${JSON.stringify({ maxBid })}\\n\\n`;\n      connections.forEach(response => response.write(event));\n    }\n  }\n}",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "N4nZwfygEDphaauav1ixh",
      "type": "text",
      "x": 12132.632231741707,
      "y": 12986.92103289412,
      "width": 1237.2916259765625,
      "height": 70,
