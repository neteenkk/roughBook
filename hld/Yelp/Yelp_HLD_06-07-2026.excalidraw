    {
      "id": "B2V03dRBKW5pL03EgCGqb",
      "type": "text",
      "x": 7054.126535475504,
      "y": 9244.20895039744,
      "width": 859.82373046875,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
