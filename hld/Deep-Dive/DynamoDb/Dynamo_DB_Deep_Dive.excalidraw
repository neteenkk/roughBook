    },
    {
      "id": "X7q8F9bjZ9wRBLwpNN_l5",
      "type": "text",
      "x": 172.4828164568474,
      "y": 6047.696915746446,
      "width": 11.199996948242188,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
