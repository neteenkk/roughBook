      "type": "text",
      "x": 467.92777521201083,
      "y": 7315.269252851643,
      "width": 1518.6910400390625,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
