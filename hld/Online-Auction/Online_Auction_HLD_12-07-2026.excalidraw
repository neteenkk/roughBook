    },
    {
      "id": "flBF2QW-Ea8838JeFa4ga",
      "type": "text",
      "x": 11915.45486910717,
      "y": 15408.250691969455,
      "width": 718.647705078125,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b50",
      "roundness": null,
      "seed": 620319720,
      "version": 3,
      "versionNonce": 1658275992,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1783867933179,
      "link": null,
      "locked": false,
      "text": "const { auctionId, maxBid } = JSON.parse(message);",
