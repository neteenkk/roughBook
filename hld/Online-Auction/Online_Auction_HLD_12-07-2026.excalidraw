      "isDeleted": true,
      "boundElements": null,
      "updated": 1783867333276,
      "link": null,
      "locked": false,
      "text": "private connections: Map<string, Set<Response>> = new\nMap();",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "private connections: Map<string, Set<Response>> = new Map();",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "8rcI7wQr__w1wlSyo6w5Y",
      "type": "text",
      "x": 12239.350514718422,
      "y": 13303.449270898982,
      "width": 783.8877563476562,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b46",
      "roundness": null,
      "seed": 1013048040,
      "version": 3,
      "versionNonce": 255252376,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1783867333276,
      "link": null,
      "locked": false,
      "text": "addConnection(auctionId: string, connection: Response) {",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "addConnection(auctionId: string, connection: Response) {",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ufVE_zvWxxb6Z6Rp0NJpQ",
      "type": "text",
      "x": 12371.594502755532,
      "y": 13348.449270898982,
      "width": 519.3997802734375,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b47",
      "roundness": null,
      "seed": 491790232,
      "version": 3,
      "versionNonce": 1173753320,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1783867333276,
      "link": null,
      "locked": false,
      "text": "if (!this.connections.has(auctionId)) {",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
