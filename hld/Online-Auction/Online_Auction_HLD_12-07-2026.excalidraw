    {
      "id": "Xm4AzRkgo5LGwAm3-Er-G",
      "type": "text",
      "x": 12086.179210363876,
      "y": 10913.167466146526,
      "width": 1345.00732421875,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3S",
      "roundness": null,
      "seed": 341207272,
      "version": 107,
      "versionNonce": 1206585064,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783866575434,
      "link": null,
      "locked": false,
      "text": "- This approach avoid locks while manintaing consistency, occasional retry when conflicts do occur.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- This approach avoid locks while manintaing consistency, occasional retry when conflicts do occur.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rFiIqFPz8KrkbYARhUdxF",
      "type": "text",
      "x": 12048.444282601515,
      "y": 11062.858019826237,
      "width": 943.0676879882812,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3T",
      "roundness": null,
      "seed": 23498728,
      "version": 21,
      "versionNonce": 627159016,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783866602393,
      "link": null,
      "locked": false,
      "text": "2) How can we ensure that the system is fault tolerant and durable?",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2) How can we ensure that the system is fault tolerant and durable?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "3OXH41xVWGdSfuzJUMJNW",
      "type": "text",
      "x": 12092.241221937456,
      "y": 11106.788766124282,
      "width": 395.723876953125,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3U",
      "roundness": null,
      "seed": 23949720,
      "version": 30,
      "versionNonce": 75049624,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783866673584,
      "link": null,
      "locked": false,
      "text": "- Message Queue (like Kafka)",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Message Queue (like Kafka)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "qNT4Sbxxm-cuRZR5WgXhp",
      "type": "text",
      "x": 12171.40998511026,
      "y": 11141.974883089972,
      "width": 11.199996948242188,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
