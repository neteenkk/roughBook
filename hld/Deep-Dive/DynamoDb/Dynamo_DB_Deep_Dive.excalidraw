      "isDeleted": false,
      "boundElements": null,
      "updated": 1783157724923,
      "link": null,
      "locked": false,
      "text": "- DynamoDB is a fully-managed, highly scalable, key-value service provided by AWS",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- DynamoDB is a fully-managed, highly scalable, key-value service provided by AWS",
