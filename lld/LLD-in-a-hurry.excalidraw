      "isDeleted": false,
      "boundElements": null,
      "updated": 1786762020815,
      "link": null,
      "locked": false,
      "text": "\"The game ends when a player wins or the board is full.\"        Game state (in progress, won, draw) and the winner (if\nany)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"The game ends when a player wins or the board is full.\"        Game state (in progress, won, draw) and the winner (if any)",
