      "seed": 1575434365,
      "version": 80,
      "versionNonce": 1290189779,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783311202764,
      "link": null,
      "locked": false,
      "text": "2) How would you modify your system to ensure that a user can\nonly leave one review per business?",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2) How would you modify your system to ensure that a user can only leave one review per business?",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "Dbcq54oQx2HGYhf_GrUZP",
      "type": "text",
      "x": 10703.268916690491,
      "y": 11688.307903449893,
      "width": 1568.6429443359375,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0m",
      "roundness": null,
      "seed": 1547483731,
      "version": 5,
      "versionNonce": 1935636691,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783311413479,
      "link": null,
      "locked": false,
      "text": "- it stops competitors from repeatedly leaving negative reviews (such as 1-star ratings) on their rivals' businesses.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- it stops competitors from repeatedly leaving negative reviews (such as 1-star ratings) on their rivals' businesses.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
