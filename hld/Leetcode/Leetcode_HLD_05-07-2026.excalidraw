      "text": "- query the submission table for all items/rows with the competitionId and then group by userId, ordering by the number of distinct problems solved \n(since a user might submit multiple passing solutions for the same problem).",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- query the submission table for all items/rows with the competitionId and then group by userId, ordering by the number of distinct problems solved \n(since a user might submit multiple passing solutions for the same problem).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "L5UOJg4qsJ4n_aR-wU7x7",
      "type": "text",
      "x": 3531.1023262216368,
      "y": 10346.781467939665,
      "width": 778.231689453125,
      "height": 245,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bCX",
      "roundness": null,
      "seed": 1264897154,
      "version": 75,
      "versionNonce": 1666250871,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783252488778,
      "link": null,
      "locked": false,
      "text": "SELECT userId, COUNT(DISTINCT problemId) as\nnumSolvedProblems, MIN(submittedAt) as lastSolveTime\nFROM submissions\nWHERE competitionId = :competitionId AND passed =\ntrue\nGROUP BY userId\nORDER BY numSolvedProblems DESC, lastSolveTime ASC",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT userId, COUNT(DISTINCT problemId) as numSolvedProblems, MIN(submittedAt) as lastSolveTime\nFROM submissions\nWHERE competitionId = :competitionId AND passed = true\nGROUP BY userId\nORDER BY numSolvedProblems DESC, lastSolveTime ASC",
      "autoResize": false,
      "lineHeight": 1.25
    },
