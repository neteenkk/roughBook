    {
      "id": "RssIIUIYbU9Kl-gWXcMpz",
      "type": "text",
      "x": 311.2348145170961,
      "y": 12513.415811963885,
      "width": 1688.959228515625,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9z",
      "roundness": null,
      "seed": 717255582,
      "version": 71,
      "versionNonce": 350828254,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783159783310,
      "link": null,
      "locked": false,
      "text": "- Streams capture changes to items in a table and make them available for processing in real-time. \n- Any change event in a table, such as an insert, update, or delete operation, is recorded in the stream as a stream record \n  to be consumed by downstream applications.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Streams capture changes to items in a table and make them available for processing in real-time. \n- Any change event in a table, such as an insert, update, or delete operation, is recorded in the stream as a stream record \n  to be consumed by downstream applications.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "QG642Ylsx9jff6iU-jLAU",
      "type": "text",
      "x": 275.20550497972096,
      "y": 12719.766965290792,
      "width": 1381.995361328125,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bA0",
      "roundness": null,
      "seed": 205649118,
      "version": 135,
      "versionNonce": 1050323742,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783159783310,
      "link": null,
      "locked": false,
      "text": "Dynamo DB - Knowing its limitations\n- Complex Query Patterns\n- Data Modeling Constraints: If you find yourself frequently using Global Secondary Indexes (GSIs) \n  and Local Secondary Indexes (LSIs), a relational database like PostgreSQL might be a better fit.\n- Vendor Lock-in",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dynamo DB - Knowing its limitations\n- Complex Query Patterns\n- Data Modeling Constraints: If you find yourself frequently using Global Secondary Indexes (GSIs) \n  and Local Secondary Indexes (LSIs), a relational database like PostgreSQL might be a better fit.\n- Vendor Lock-in",
      "autoResize": true,
      "lineHeight": 1.25
    },
