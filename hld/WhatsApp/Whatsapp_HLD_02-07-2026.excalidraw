      "boundElements": null,
      "updated": 1782966008638,
      "link": null,
      "locked": false,
      "text": "EntityKey     Fields\n\nUser           id, name\nChannel        id, org, name, type: group | user\nMembership   userId, channelId, checkpoint, muted, lastRead\nMessage      from, channelId, createdAt, msg",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
