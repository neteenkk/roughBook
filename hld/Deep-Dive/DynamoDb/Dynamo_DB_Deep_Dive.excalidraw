      "isDeleted": true,
      "boundElements": null,
      "updated": 1783159007030,
      "link": null,
      "locked": false,
      "text": "But in DynamoDB, this would be translated to a query\noperation like this:",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "But in DynamoDB, this would be translated to a query operation like this:",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "FrcSmXdagzCfuM789cXID",
      "type": "text",
      "x": 196.99648781744406,
      "y": 10354.74416303424,
      "width": 230.91592407226562,
