      "isDeleted": false,
      "boundElements": null,
      "updated": 1782965618041,
      "link": null,
      "locked": false,
      "text": "Out of Scope:\nAudio Video calling\nRegistration & profile management",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Out of Scope:\nAudio Video calling\nRegistration & profile management",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ExoIaezTqMt6_DIeNxcGH",
      "type": "text",
      "x": -5070.142607234987,
      "y": 6809.750710024726,
      "width": 765.4638061523438,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2q",
      "roundness": null,
      "seed": 1218728552,
      "version": 180,
      "versionNonce": 1835682152,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1782965726459,
      "link": null,
      "locked": false,
      "text": "Non FRs:\n1. Msg to be delivered to user with low latency < 500ms\n2. We should guarantee deliverability of msg to users.\n3. Scalability: support millions of concurrent WebSocket \n   connections & channels with large fan-out ",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non FRs:\n1. Msg to be delivered to user with low latency < 500ms\n2. We should guarantee deliverability of msg to users.\n3. Scalability: support millions of concurrent WebSocket \n   connections & channels with large fan-out ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "93-7Q8grS5PmiZYddaC_d",
      "type": "text",
