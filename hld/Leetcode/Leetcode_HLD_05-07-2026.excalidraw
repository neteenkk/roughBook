      "boundElements": [],
      "updated": 1783252498652,
      "link": null,
      "locked": false,
      "text": "LeetCode only has a few hundred thousand users and roughly 4,000 problems. Relative to most system design\ninterviews, this is a small-scale system.\nPattern: Manage Long Running Task",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LeetCode only has a few hundred thousand users and roughly 4,000 problems. Relative to most system design interviews, this is a small-scale system.\nPattern: Manage Long Running Task",
      "autoResize": false,
      "lineHeight": 1.25
