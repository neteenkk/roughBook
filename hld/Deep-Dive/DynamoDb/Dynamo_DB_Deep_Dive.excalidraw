    {
      "id": "AREyCa52YlkTz3Xbib73w",
      "type": "text",
      "x": 242.7503831540639,
      "y": 10048.725181973643,
      "width": 748.6077880859375,
      "height": 630,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
