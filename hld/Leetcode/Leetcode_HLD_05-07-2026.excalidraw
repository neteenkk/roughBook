      "type": "text",
      "x": 3527.2015430183637,
      "y": 7258.393970617197,
      "width": 289.63189697265625,
      "height": 630,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
