    {
      "id": "VO_TCykOHv5wV1p1CO1Nh",
      "type": "text",
      "x": 8936.346396161212,
      "y": 8308.883753109993,
      "width": 1322.7193603515625,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2H",
      "roundness": null,
      "seed": 1328104701,
      "version": 3,
      "versionNonce": 487582141,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783864310234,
      "link": null,
      "locked": false,
      "text": "An online auction service lets users list items for sale while others compete to purchase them by\nplacing increasingly higher bids until the auction ends, with the highest bidder winning the item.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "An online auction service lets users list items for sale while others compete to purchase them by\nplacing increasingly higher bids until the auction ends, with the highest bidder winning the item.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5dd5gUpPUrpIQuK6-kzc4",
      "type": "text",
      "x": 8896.858648056466,
      "y": 8557.11191948074,
      "width": 983.6396484375,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2I",
      "roundness": null,
      "seed": 1269952275,
      "version": 114,
      "versionNonce": 1278466301,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783864537342,
      "link": null,
      "locked": false,
      "text": "FRs\n- User should be able to post  an item for auction with a starting price\n and end date.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FRs\n- User should be able to post  an item for auction with a starting price\n and end date.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ZAJBPlO-Q3GDpU_zRaxRU",
      "type": "text",
      "x": 8884.061454366554,
      "y": 8660.629189623942,
      "width": 1009.231689453125,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2K",
      "roundness": null,
      "seed": 887668253,
      "version": 207,
      "versionNonce": 209446632,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783864591254,
      "link": null,
      "locked": false,
      "text": "- User should be able to bid on an item. Where bids are accepted if they\n are higher than their current highest bid.\n- User should be able to view an auction, including the current highest bid",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- User should be able to bid on an item. Where bids are accepted if they\n are higher than their current highest bid.\n- User should be able to view an auction, including the current highest bid",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "VFentFj-0GEqvOdr2Ukh-",
      "type": "text",
      "x": 8890.122073584544,
      "y": 8819.682753678111,
      "width": 1046.4156494140625,
      "height": 245,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2L",
      "roundness": null,
      "seed": 2110066840,
      "version": 384,
      "versionNonce": 1600963480,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783864844928,
      "link": null,
      "locked": false,
      "text": "NFRs\n- System should maintain strong consistency for bids to ensure all users see\n  the same highest bid.\n- System should be fault tolerant and durable. We shouldn;t drop any bids.\n- The System should display current highest bid inn real-time so users know\n   what they are bidding against\n- The System should scale to support 10M concurrent auctions.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NFRs\n- System should maintain strong consistency for bids to ensure all users see\n  the same highest bid.\n- System should be fault tolerant and durable. We shouldn;t drop any bids.\n- The System should display current highest bid inn real-time so users know\n   what they are bidding against\n- The System should scale to support 10M concurrent auctions.",
      "autoResize": true,
      "lineHeight": 1.25
    },
