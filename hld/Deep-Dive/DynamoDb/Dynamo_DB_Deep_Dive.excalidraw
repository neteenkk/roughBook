      "text": "- LSIs can only be defined at table creation time and cannot be added or removed later, so you need to plan ahead.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- LSIs can only be defined at table creation time and cannot be added or removed later, so you need to plan ahead.",
      "autoResize": true,
      "lineHeight": 1.25
    },
