      "isDeleted": false,
      "boundElements": null,
      "updated": 1783311820350,
      "link": null,
      "locked": false,
      "text": "Category: To efficiently search by category we can use a simple B-tree index.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Category: To efficiently search by category we can use a simple B-tree index.",
      "autoResize": false,
      "lineHeight": 1.25
    },
