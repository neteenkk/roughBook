    {
      "id": "HvQ0W-k33Ol4EIdgndWrL",
      "type": "text",
      "x": 2323.1622168695812,
      "y": 12173.633740249885,
      "width": 801.7196655273438,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
