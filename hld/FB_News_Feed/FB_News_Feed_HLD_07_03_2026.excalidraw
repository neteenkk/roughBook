    {
      "id": "Sj8r_fC4gi8qflffVHyRk",
      "type": "text",
      "x": -3891.185472359898,
      "y": 6074.653847494961,
      "width": 1359.6605224609375,
      "height": 691.1635160536119,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
