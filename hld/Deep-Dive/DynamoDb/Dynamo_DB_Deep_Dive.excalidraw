      "updated": 1783159430601,
      "link": null,
      "locked": false,
      "text": "1) DAX (DynamoDB Accelerator)",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) DAX (DynamoDB Accelerator)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "aujZVm3MeZeis4-nJqtXN",
      "type": "text",
      "x": 288.6910520520912,
      "y": 11784.529942145977,
      "width": 1907.779052734375,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9v",
      "roundness": null,
      "seed": 1722950686,
      "version": 51,
      "versionNonce": 1608477250,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783159461552,
      "link": null,
      "locked": false,
      "text": "- DAX is a caching service designed to enhance DynamoDB performance by delivering microsecond response times for read-heavy workloads. \n- DAX does not cache strongly consistent reads. \n- When you request a strongly consistent read through DAX, it passes the request directly to DynamoDB \n and returns the result without caching it.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- DAX is a caching service designed to enhance DynamoDB performance by delivering microsecond response times for read-heavy workloads. \n- DAX does not cache strongly consistent reads. \n- When you request a strongly consistent read through DAX, it passes the request directly to DynamoDB \n and returns the result without caching it.",
      "autoResize": true,
      "lineHeight": 1.25
    },
