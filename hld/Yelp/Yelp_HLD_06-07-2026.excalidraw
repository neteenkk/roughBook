      "updated": 1783308939500,
      "link": null,
      "locked": false,
      "text": "- Search for Buisness\nGET /buisnesses?query&location&category&page -> Buisness[]\n\n- View buisness and review\nGET /buisnesses/:buisnessId -> Buisness & Review[]\n\n- View Review for Buisnesses\nGET /buisnesses/:buisnessId/reviews?page= -> Review[]\n\n- Leave a Review\n  POST /buisnesses/:buisnessId/reviews\n  {\n      rating: number,\n      text?: string\n  }",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Search for Buisness\nGET /buisnesses?query&location&category&page -> Buisness[]\n\n- View buisness and review\nGET /buisnesses/:buisnessId -> Buisness & Review[]\n\n- View Review for Buisnesses\nGET /buisnesses/:buisnessId/reviews?page= -> Review[]\n\n- Leave a Review\n  POST /buisnesses/:buisnessId/reviews\n  {\n      rating: number,\n      text?: string\n  }",
      "autoResize": true,
      "lineHeight": 1.25
    },
