    {
      "id": "8pQDJ4bPG40FMZtKRLVJK",
      "type": "text",
      "x": 163.75733445483274,
      "y": 6007.071092929574,
      "width": 1117.7239418870638,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
