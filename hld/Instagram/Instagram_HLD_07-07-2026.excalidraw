      "boundElements": null,
      "updated": 1783420465368,
      "link": null,
      "locked": false,
      "text": "Requirement",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Requirement",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "RePqpqUmuB5-Q2FlnQCl_",
      "type": "text",
      "x": 6230.2351651254085,
      "y": 9163.975927990252,
      "width": 1544.219482421875,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1i",
      "roundness": null,
      "seed": 244503837,
      "version": 41,
      "versionNonce": 2112542131,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783422485201,
      "link": null,
      "locked": false,
      "text": "Functional Requirement:\n - Users should be able to create posts featuring photos, videos, and a simple caption.\n- Users should be able to follow other users.\n- Users should be able to see a chronological feed of posts from the users they follow.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirement:\n - Users should be able to create posts featuring photos, videos, and a simple caption.\n- Users should be able to follow other users.\n- Users should be able to see a chronological feed of posts from the users they follow.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rWB3lErnpXlO7BluVRr9T",
      "type": "text",
      "x": 6243.45955409713,
      "y": 9611.173633835555,
      "width": 1128.20361328125,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1j",
      "roundness": null,
      "seed": 980285107,
      "version": 317,
      "versionNonce": 1565150205,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783421180564,
      "link": null,
      "locked": false,
      "text": "Non Functional Requirement:\n- System should be highly availaible, eventual consistency is fine.\n- System should deliver feed content with low latency (<500ms)\n- System should render photos and videos instantly.\n- System should be scalable to support 500M DAU.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non Functional Requirement:\n- System should be highly availaible, eventual consistency is fine.\n- System should deliver feed content with low latency (<500ms)\n- System should render photos and videos instantly.\n- System should be scalable to support 500M DAU.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "SLSQmiwQSo5hr8ANA-CnJ",
      "type": "text",
      "x": 6252.387938802599,
      "y": 9400.169665903772,
      "width": 892.2236328125,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1k",
      "roundness": null,
      "seed": 499179187,
      "version": 132,
      "versionNonce": 1683331635,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783420563074,
      "link": null,
      "locked": false,
      "text": "Out of Scope:\n- User should be able to like and comment on post.\n- User should be able to go live.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Out of Scope:\n- User should be able to like and comment on post.\n- User should be able to go live.",
      "autoResize": true,
      "lineHeight": 1.25
    },
