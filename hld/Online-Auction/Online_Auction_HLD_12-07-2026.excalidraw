    },
    {
      "id": "wsrRDunCWznz7dI7OsoER",
      "type": "text",
      "x": 12101.912375417392,
      "y": 8682.786284688378,
      "width": 1069.9356689453125,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3B",
      "roundness": null,
      "seed": 1631482088,
      "version": 6,
      "versionNonce": 1087455208,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783865760224,
      "link": null,
      "locked": false,
      "text": "- Online auctions are a classic example of the dealing with contention pattern.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Online auctions are a classic example of the dealing with contention pattern.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "vcX1L_UQoW9-7HweZq8nD",
      "type": "text",
      "x": 12101.970644968524,
      "y": 8712.610519059243,
      "width": 1371.1591796875,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3C",
      "roundness": null,
      "seed": 129402600,
      "version": 8,
      "versionNonce": 331009512,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783865756547,
      "link": null,
      "locked": false,
      "text": "- This requires careful coordination using techniques like optimistic concurrency control, row locking, \n or caching strategies to manage competition for the same resource.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- This requires careful coordination using techniques like optimistic concurrency control, row locking, \n or caching strategies to manage competition for the same resource.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "uyTvq2gaq59mX8AcNZkmB",
      "type": "text",
      "x": 12084.45534464373,
      "y": 8816.408003986311,
      "width": 812.7557373046875,
      "height": 630,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3D",
      "roundness": null,
      "seed": 163971304,
      "version": 59,
      "versionNonce": 69537000,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783866111181,
      "link": null,
      "locked": false,
      "text": "Bad Solution: Row Locking with Bids Query\nBEGIN;\n\n-- Lock all existing bid rows for this auction\nSELECT id, amount FROM bids\nWHERE auction_id = :auction_id\nFOR UPDATE;\n\n-- Get current max (from the locked rows)\nSELECT MAX(amount) AS max_bid FROM bids\nWHERE auction_id = :auction_id;\n\n-- Insert if the new bid beats the current max\nINSERT INTO bids (auction_id, user_id, amount, bid_time)\nVALUES (:auction_id, :user_id, :amount, NOW())\nWHERE :amount > COALESCE(:max_bid, 0);\n\nCOMMIT;",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bad Solution: Row Locking with Bids Query\nBEGIN;\n\n-- Lock all existing bid rows for this auction\nSELECT id, amount FROM bids\nWHERE auction_id = :auction_id\nFOR UPDATE;\n\n-- Get current max (from the locked rows)\nSELECT MAX(amount) AS max_bid FROM bids\nWHERE auction_id = :auction_id;\n\n-- Insert if the new bid beats the current max\nINSERT INTO bids (auction_id, user_id, amount, bid_time)\nVALUES (:auction_id, :user_id, :amount, NOW())\nWHERE :amount > COALESCE(:max_bid, 0);\n\nCOMMIT;",
      "autoResize": true,
      "lineHeight": 1.25
    },
