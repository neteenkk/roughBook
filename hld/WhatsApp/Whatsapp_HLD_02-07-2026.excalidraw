      "seed": 921895192,
      "version": 114,
      "versionNonce": 1616163608,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1782975892142,
      "link": null,
      "locked": false,
      "text": "1) Users should be able to send/receive media in their messages.\n - We give user permissions to directly upload to blob-storage via pre-signed urls\n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) Users should be able to send/receive media in their messages.\n - We give user permissions to directly upload to blob-storage via pre-signed urls\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
