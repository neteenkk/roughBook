      "isDeleted": false,
      "boundElements": null,
      "updated": 1783061883901,
      "link": null,
      "locked": false,
      "text": "function encodeCursor(post: Post): string {\n  // base64 so it's an opaque token to the\nclient\n  const raw =\n`${post.createdAt}:${post.id}`;\n  return\nBuffer.from(raw).toString('base64url');\n}",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function encodeCursor(post: Post): string {\n  // base64 so it's an opaque token to the client\n  const raw = `${post.createdAt}:${post.id}`;\n  return Buffer.from(raw).toString('base64url');\n}",
      "autoResize": false,
      "lineHeight": 1.25
    },
