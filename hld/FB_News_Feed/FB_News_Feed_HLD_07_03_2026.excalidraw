      "isDeleted": false,
      "boundElements": null,
      "updated": 1783081466982,
      "link": null,
      "locked": false,
      "text": "-  users are viewing posts from youngest to oldest, that one timestamp tells us where they've stopped and provides a great cursor for the \n   next set of posts.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-  users are viewing posts from youngest to oldest, that one timestamp tells us where they've stopped and provides a great cursor for the \n   next set of posts.",
      "autoResize": true,
      "lineHeight": 1.25
    },
