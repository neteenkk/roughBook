      "seed": 1857253352,
      "version": 126,
      "versionNonce": 259525096,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783867947918,
      "link": null,
      "locked": false,
      "text": "// Server A, after accepting the bid and writing to DB\nawait pubsub.publish('auction-updates', JSON.stringify({\n  auctionId: 'auction-123',\n  maxBid: 150\n}));",
